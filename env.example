# Local development example. Never commit a real DATABASE_URL or API token.

APP_ENV=development

# PostgreSQL connection URL. Render supplies this from its Postgres service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/satark

# Required outside local loopback development.
API_ACCESS_TOKEN=

# Explicit backend hostnames accepted by the API.
TRUSTED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend origins allowed to call this API from a browser.
ALLOWED_ORIGINS=http://localhost:4175,http://127.0.0.1:4175,http://localhost:4176,http://127.0.0.1:4176,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://localhost

# Optional registered inspection-site coordinates, keyed by organization name.
SITE_LOCATIONS_JSON={}
